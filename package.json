{
  "name": "cybercompanion",
  "version": "1.1.4",
  "description": "CyberCompanion — An interactive, offline educational guide for Web Application Penetration Testing",
  "main": "main.js",
  "author": "CyberAcademy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test && node scripts/check-css.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.cyberacademy.cybercompanion",
    "productName": "CyberCompanion",
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!temp_asar/**",
      "!restored_from_exe/**",
      "!**/*.map",
      "!**/*.log",
      "!.*/**",
      "!docs/**",
      "!tests/**",
      "!scripts/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  }
}
